# Storage job settings — pushing a change starts library-storage.yml
# MODE: stats (sizes only) · plan (read-only R2 plan) · migrate (move library texts to R2)
#       rebuild (copy + swap books.chapters to release disk left by the moved texts)
# Full migration finished 2026-10-21 (18,722 chapters → R2). migrate is safe to re-run (resumes / repairs).
MODE=rebuild
LIMIT_BOOKS=0
