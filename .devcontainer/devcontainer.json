{
  "name": "Codespace with Flutter + Android Emulator",
  "build": { "dockerfile": "Dockerfile" },
  "postCreateCommand": "flutter doctor -v && yes | flutter doctor --android-licenses",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.flutter",
        "ms-vscode.cpptools"
      ]
    }
  },
  "remoteUser": "vscode"
}
