{
  // Click-to-run commands for GitHub Codespaces / VS Code.
  // Terminal → Run Task… (or Ctrl+Shift+P → "Tasks: Run Task").
  "version": "2.0.0",
  "tasks": [
    {
      "label": "BookNest: run (web)",
      "type": "shell",
      "command": "flutter run -d web-server --web-hostname 0.0.0.0 --web-port 8080",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "BookNest: fetch packages",
      "type": "shell",
      "command": "flutter pub get",
      "problemMatcher": []
    },
    {
      "label": "BookNest: analyze code",
      "type": "shell",
      "command": "flutter analyze --no-fatal-infos --no-fatal-warnings",
      "problemMatcher": []
    }
  ]
}
