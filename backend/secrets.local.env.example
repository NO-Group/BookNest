# BookNest backend secrets — LOCAL ONLY, never committed.
# Copy this file to:  backend/secrets.local.env   (that copy is git-ignored)
# Fill in the real values, then run:  bash backend/setup_secrets.sh
#
# RULES:
#  • The Flutter app only ever gets SUPABASE_URL, SUPABASE_ANON_KEY,
#    CLOUDINARY_CLOUD_NAME, CLOUDINARY_UPLOAD_PRESET, R2_PUBLIC_DOMAIN_URL
#    (already wired in lib/config/app_config.dart).
#  • EVERYTHING below is server-side only (Edge Function secrets).

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_PROJECT_REF=ekgbbbbjwgfixqarlnil
SUPABASE_URL=https://ekgbbbbjwgfixqarlnil.supabase.co
SUPABASE_ANON_KEY=paste-anon-key-here
# SUPABASE_* keys (incl. service role) are RESERVED and auto-injected into
# edge functions by Supabase — never add them manually (the dashboard blocks them).

# ── MongoDB Atlas (the ONLY place this URI should ever be written down) ─────
MONGO_URI="mongodb+srv://USERNAME:PASSWORD@books.edlhho3.mongodb.net/?retryWrites=true&w=majority&appName=Books"
MONGO_DB_NAME=booknest

# ── Cloudflare R2 (leave values empty until you create the bucket) ──────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=booknest-stem-media
R2_PUBLIC_DOMAIN_URL=

# ── Cloudinary (API key + secret are server-side ONLY) ──────────────────────
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
